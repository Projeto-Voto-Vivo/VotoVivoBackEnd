generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Parliamentarian {
  id                 Int                        @id @default(autoincrement()) @map("idParlamentar")
  apiId              String?                    @unique(map: "idApi") @map("idApi") @db.VarChar(100)
  role               String?                    @map("cargo") @db.VarChar(50)
  civilName          String?                    @map("nomeCivil") @db.VarChar(255)
  ballotName         String?                    @map("nomeUrna") @db.VarChar(255)
  currentParty       String?                    @map("partidoAtual") @db.VarChar(50)
  state              String?                    @map("uf") @db.Char(2)
  photoUrl           String?                    @map("fotoUrl") @db.VarChar(500)
  birthDate          DateTime?                  @map("dataNascimento") @db.Date
  email              String?                    @db.VarChar(255)
  phone              String?                    @map("telefone") @db.VarChar(20)
  officeAddress      String?                    @map("enderecoGabinete") @db.VarChar(500)
  propositionAuthors PropositionAuthor[]
  expenses           Expense[]
  amendmentLinks     AmendmentParliamentarian[]
  presences          Presence[]
  socialNetworks     SocialNetwork[]
  votes              Vote[]

  @@map("parlamentar")
}

model PropositionType {
  id           Int                 @id @default(autoincrement()) @map("idTipoProposicao")
  sigla        String              @db.VarChar(10)
  nome         String              @db.VarChar(255)
  casa         tipoProposicao_casa
  propositions Proposition[]

  @@unique([sigla, casa], map: "unique_sigla_casa")
  @@map("tipoProposicao")
}

model Proposition {
  id              Int                 @id @default(autoincrement()) @map("idProposicao")
  apiId           String?             @unique(map: "idApi") @map("idApi") @db.VarChar(100)
  typeId          Int?                @map("idTipoProposicao")
  number          String?             @map("numero") @db.VarChar(20)
  year            Int?                @map("ano")
  summary         String?             @map("ementa") @db.Text
  currentStatus   String?             @map("statusAtual") @db.VarChar(255)
  authors         PropositionAuthor[]
  propositionType PropositionType?    @relation(fields: [typeId], references: [id], onUpdate: NoAction, map: "proposicao_ibfk_1")
  temaProposicao  temaProposicao[]
  tramitacao      tramitacao[]
  votings         Voting[]

  @@index([typeId], map: "idTipoProposicao")
  @@map("proposicao")
}

model Event {
  id             Int         @id @default(autoincrement()) @map("idEvento")
  apiId          String?     @unique(map: "idApi") @map("idApi") @db.VarChar(100)
  house          evento_casa @map("casa")
  idOrgao        Int?
  dataHoraInicio DateTime?   @db.DateTime(0)
  descricaoTipo  String?     @db.VarChar(100)
  orgao          orgao?      @relation(fields: [idOrgao], references: [idOrgao], onUpdate: NoAction, map: "evento_ibfk_1")
  presences      Presence[]

  @@index([idOrgao], map: "idOrgao")
  @@map("evento")
}

model Presence {
  id                Int                     @id @default(autoincrement()) @map("idPresenca")
  parliamentarianId Int                     @map("idParlamentar")
  eventId           Int                     @map("idEvento")
  status            presenca_statusPresenca @map("statusPresenca")
  justificativa     String?                 @db.VarChar(255)
  parliamentarian   Parliamentarian         @relation(fields: [parliamentarianId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "presenca_ibfk_1")
  event             Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "presenca_ibfk_2")

  @@unique([parliamentarianId, eventId], map: "unique_presenca_evento")
  @@index([eventId], map: "idEvento")
  @@map("presenca")
}

model Voting {
  id             Int                  @id @default(autoincrement()) @map("idVotacao")
  apiId          String?              @unique(map: "idApi") @map("idApi") @db.VarChar(100)
  casa           votacao_casa
  propositionId  Int?                 @map("idProposicao")
  idOrgao        Int?
  votingDate     DateTime?            @map("dataHora") @db.DateTime(0)
  subjectSummary String?              @map("resumoMateria") @db.Text
  finalResult    String?              @map("resultadoFinal") @db.VarChar(100)
  votingType     votacao_tipoVotacao? @map("tipoVotacao")
  proposition    Proposition?         @relation(fields: [propositionId], references: [id], onUpdate: NoAction, map: "votacao_ibfk_1")
  orgao          orgao?               @relation(fields: [idOrgao], references: [idOrgao], onUpdate: NoAction, map: "votacao_ibfk_2")
  votes          Vote[]

  @@index([idOrgao], map: "idOrgao")
  @@index([propositionId], map: "idProposicao")
  @@map("votacao")
}

model Vote {
  id                Int                 @id @default(autoincrement()) @map("idVoto")
  parliamentarianId Int                 @map("idParlamentar")
  votingId          Int                 @map("idVotacao")
  idApi             String              @unique(map: "idApi") @db.VarChar(50)
  choice            VoteChoice @map("votoRegistrado")
  parliamentarian   Parliamentarian     @relation(fields: [parliamentarianId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "voto_ibfk_1")
  voting            Voting              @relation(fields: [votingId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "voto_ibfk_2")

  @@index([parliamentarianId], map: "idParlamentar")
  @@index([votingId], map: "idVotacao")
  @@map("voto")
}

model PropositionAuthor {
  parliamentarianId Int             @map("idParlamentar")
  propositionId     Int             @map("idProposicao")
  parliamentarian   Parliamentarian @relation(fields: [parliamentarianId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "autoriaProposicao_ibfk_1")
  proposition       Proposition     @relation(fields: [propositionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "autoriaProposicao_ibfk_2")

  @@id([parliamentarianId, propositionId])
  @@index([propositionId], map: "idProposicao")
  @@map("autoriaProposicao")
}

model SocialNetwork {
  id                Int             @id @default(autoincrement()) @map("idRedeSocial")
  parliamentarianId Int             @map("idParlamentar")
  platform          String?         @map("plataforma") @db.VarChar(50)
  url               String?         @db.VarChar(500)
  parliamentarian   Parliamentarian @relation(fields: [parliamentarianId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "redeSocial_ibfk_1")

  @@index([parliamentarianId], map: "idParlamentar")
  @@map("redeSocial")
}

model Expense {
  id                Int             @id @default(autoincrement()) @map("idDespesa")
  parliamentarianId Int             @map("idParlamentar")
  expenseDate       DateTime?       @map("dataDespesa") @db.Date
  amount            Decimal?        @map("valor") @db.Decimal(10, 2)
  supplierName      String?         @map("fornecedorNome") @db.VarChar(255)
  supplierDocument  String?         @map("fornecedorCnpjCpf") @db.VarChar(20)
  invoiceUrl        String?         @map("notaFiscalUrl") @db.VarChar(500)
  category          String?         @map("categoria") @db.VarChar(100)
  parliamentarian   Parliamentarian @relation(fields: [parliamentarianId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "despesa_ibfk_1")

  @@index([expenseDate], map: "idx_despesa_data")
  @@index([parliamentarianId], map: "idx_despesa_parlamentar")
  @@map("despesa")
}

model Amendment {
  id                   Int                        @id @default(autoincrement()) @map("idEmenda")
  code                 String                     @unique(map: "codigoEmenda") @map("codigoEmenda") @db.VarChar(100)
  year                 Int?                       @map("ano")
  amendmentType        String?                    @map("tipoEmenda") @db.VarChar(100)
  author               String?                    @map("autor") @db.VarChar(255)
  authorName           String?                    @map("nomeAutor") @db.VarChar(255)
  amendmentNumber      String?                    @map("numeroEmenda") @db.VarChar(100)
  spendingLocation     String?                    @map("localidadeDoGasto") @db.VarChar(255)
  functionName         String?                    @map("funcao") @db.VarChar(255)
  subfunctionName      String?                    @map("subfuncao") @db.VarChar(255)
  committedAmount      Decimal?                   @map("valorEmpenhado") @db.Decimal(15, 2)
  liquidatedAmount     Decimal?                   @map("valorLiquidado") @db.Decimal(15, 2)
  paidAmount           Decimal?                   @map("valorPago") @db.Decimal(15, 2)
  remainderRegistered  Decimal?                   @map("valorRestoInscrito") @db.Decimal(15, 2)
  remainderCanceled    Decimal?                   @map("valorRestoCancelado") @db.Decimal(15, 2)
  remainderPaid        Decimal?                   @map("valorRestoPago") @db.Decimal(15, 2)
  documents            AmendmentDocument[]
  parliamentarianLinks AmendmentParliamentarian[]

  @@index([year], map: "idx_emenda_ano")
  @@index([author], map: "idx_emenda_autor")
  @@index([code], map: "idx_emenda_codigo")
  @@index([amendmentType], map: "idx_emenda_tipo")
  @@map("emenda")
}

model AmendmentDocument {
  id                Int       @id @default(autoincrement()) @map("idEmendaDocumento")
  amendmentId       Int       @map("idEmenda")
  apiId             Int?      @map("idApi")
  amendmentCode     String    @map("codigoEmenda") @db.VarChar(100)
  date              DateTime? @map("data") @db.Date
  phase             String?   @map("fase") @db.VarChar(100)
  documentCode      String?   @map("codigoDocumento") @db.VarChar(100)
  shortDocumentCode String?   @map("codigoDocumentoResumido") @db.VarChar(100)
  speciesType       String?   @map("especieTipo") @db.VarChar(255)
  amendmentType     String?   @map("tipoEmenda") @db.VarChar(100)
  amendment         Amendment @relation(fields: [amendmentId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "emendaDocumento_ibfk_1")

  @@unique([amendmentId, documentCode], map: "unique_emenda_documento")
  @@index([amendmentCode], map: "idx_emenda_documento_codigo_emenda")
  @@index([date], map: "idx_emenda_documento_data")
  @@index([phase], map: "idx_emenda_documento_fase")
  @@index([amendmentId], map: "idx_emenda_documento_id_emenda")
  @@map("emendaDocumento")
}

model AmendmentParliamentarian {
  id                   Int             @id @default(autoincrement()) @map("idEmendaParlamentar")
  amendmentId          Int             @map("idEmenda")
  amendmentCode        String          @map("codigoEmenda") @db.VarChar(100)
  parliamentarianId    Int             @map("idParlamentar")
  authorNamePortal     String?         @map("nomeAutorPortal") @db.VarChar(255)
  normalizedAuthorName String?         @map("nomeAutorNormalizado") @db.VarChar(255)
  linkMethod           String?         @map("metodoVinculo") @db.VarChar(100)
  confidence           Decimal?        @map("confiancaVinculo") @db.Decimal(5, 2)
  amendment            Amendment       @relation(fields: [amendmentId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "emendaParlamentar_ibfk_1")
  parliamentarian      Parliamentarian @relation(fields: [parliamentarianId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "emendaParlamentar_ibfk_2")

  @@unique([amendmentId, parliamentarianId], map: "unique_emenda_parlamentar")
  @@index([amendmentCode], map: "idx_emenda_parlamentar_codigo")
  @@index([amendmentId], map: "idx_emenda_parlamentar_emenda")
  @@index([parliamentarianId], map: "idx_emenda_parlamentar_parlamentar")
  @@map("emendaParlamentar")
}

model etlCheckpoint {
  idEtlCheckpoint Int       @id @default(autoincrement())
  nomeScript      String    @unique(map: "nomeScript") @db.VarChar(100)
  ultimoParametro String    @db.VarChar(255)
  dataAtualizacao DateTime? @default(now()) @db.DateTime(0)

  @@index([nomeScript], map: "idx_etl_checkpoint_script")
}

model orgao {
  idOrgao Int        @id @default(autoincrement())
  idApi   String     @unique(map: "idApi") @db.VarChar(50)
  sigla   String?    @db.VarChar(50)
  nome    String?    @db.VarChar(500)
  casa    orgao_casa
  evento  Event[]
  votacao Voting[]
}

model tema {
  idTema         Int              @id @default(autoincrement())
  codigoExterno  Int
  casa           tema_casa
  descricao      String           @db.VarChar(255)
  nivel          tema_nivel?      @default(UNICO)
  idTemaPai      Int?
  tema           tema?            @relation("temaTotema", fields: [idTemaPai], references: [idTema], onDelete: NoAction, onUpdate: NoAction, map: "tema_ibfk_1")
  other_tema     tema[]           @relation("temaTotema")
  temaProposicao temaProposicao[]

  @@unique([codigoExterno, casa, nivel], map: "unique_tema_casa")
  @@index([idTemaPai], map: "idTemaPai")
}

model temaProposicao {
  idProposicao Int
  idTema       Int
  proposicao   Proposition @relation(fields: [idProposicao], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "temaProposicao_ibfk_1")
  tema         tema        @relation(fields: [idTema], references: [idTema], onDelete: Cascade, onUpdate: NoAction, map: "temaProposicao_ibfk_2")

  @@id([idProposicao, idTema])
  @@index([idTema], map: "idTema")
}

model tipoTramitacao {
  idTipoTramitacao Int     @id @default(autoincrement())
  idApi            Int     @unique(map: "idApi")
  descricao        String? @db.VarChar(255)
  regime           String? @db.VarChar(100)
}

model tramitacao {
  idTramitacao        Int         @id @default(autoincrement())
  idApi               String      @db.VarChar(50)
  idProposicao        Int
  idTipoTramitacao    Int?
  idOrgao             Int?
  dataHora            DateTime?   @db.DateTime(0)
  sequencia           Int?
  descricaoTramitacao String?     @db.VarChar(255)
  descricaoSituacao   String?     @db.VarChar(255)
  despacho            String?     @db.Text
  proposicao          Proposition @relation(fields: [idProposicao], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tramitacao_proposicao")

  @@unique([idApi, sequencia], map: "unique_tramitacao")
  @@index([idProposicao], map: "fk_tramitacao_proposicao")
}

enum evento_casa {
  Camara
  Senado
  Congresso
}

enum tema_casa {
  Camara
  Senado
}

enum votacao_casa {
  Camara
  Senado
  Congresso
}

enum presenca_statusPresenca {
  PRESENTE
  AUSENTE
  JUSTIFICADA
}

enum tipoProposicao_casa {
  Camara
  Senado
  Congresso
}

enum orgao_casa {
  Camara
  Senado
  Congresso
}

enum tema_nivel {
  UNICO
  GERAL
  ESPECIFICO
}

enum VoteChoice {
  SIM
  NAO
  ABSTENCAO
  AUSENTE
  SEM_REGISTRO         @map("SEM REGISTRO")
  AUSENCIA_JUSTIFICADA @map("AUSENCIA JUSTIFICADA")
}

enum votacao_tipoVotacao {
  NOMINAL
  SIMBOLICA
  SECRETA
}
