generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum VoteChoice {
  YES        @map("SIM")
  NO         @map("NAO")
  ABSTENTION @map("ABSTENCAO")
  ABSENT     @map("AUSENTE")
}

model Parliamentarian {
  id                 Int       @id @default(autoincrement()) @map("idParlamentar")
  apiId              Int       @unique @map("idApi")
  role               String?   @db.VarChar(50) @map("cargo")
  civilName          String?   @db.VarChar(255) @map("nomeCivil")
  ballotName         String?   @db.VarChar(255) @map("nomeUrna")
  currentParty       String?   @db.VarChar(50) @map("partidoAtual")
  state              String?   @db.Char(2) @map("uf")
  photoUrl           String?   @db.VarChar(500) @map("fotoUrl")
  birthDate          DateTime? @db.Date @map("dataNascimento")
  email              String?   @db.VarChar(255)
  phone              String?   @db.VarChar(20) @map("telefone")
  officeAddress      String?   @db.VarChar(500) @map("enderecoGabinete")

  votes              Vote[]
  propositionAuthors PropositionAuthor[]
  socialNetworks     SocialNetwork[]
  expenses           Expense[]
  amendmentLinks     AmendmentParliamentarian[]

  @@map("parlamentar")
}

model PropositionType {
  id           Int          @id @default(autoincrement()) @map("idTipoProposicao")
  sigla        String       @db.VarChar(10)
  nome         String       @db.VarChar(255)
  casa         String       @db.VarChar(20)

  propositions Proposition[]

  @@map("tipoProposicao")
}

model Proposition {
  id             Int              @id @default(autoincrement()) @map("idProposicao")
  apiId          Int              @unique @map("idApi")
  typeId         Int?             @map("idTipoProposicao")
  number         String?          @db.VarChar(20) @map("numero")
  year           Int?             @map("ano")
  summary        String?          @db.Text @map("ementa")
  currentStatus  String?          @db.VarChar(255) @map("statusAtual")

  propositionType PropositionType? @relation(fields: [typeId], references: [id])
  votings         Voting[]
  authors         PropositionAuthor[]

  @@map("proposicao")
}

model Voting {
  id             Int          @id @default(autoincrement()) @map("idVotacao")
  apiId          String       @unique @map("idApi")
  propositionId  Int?         @map("idProposicao")
  votingDate     DateTime?    @db.DateTime @map("dataHora")
  subjectSummary String?      @db.Text @map("resumoMateria")
  finalResult    String?      @db.VarChar(100) @map("resultadoFinal")
  votingType     String?      @db.VarChar(50) @map("tipoVotacao")

  proposition    Proposition? @relation(fields: [propositionId], references: [id], onDelete: SetNull)
  votes          Vote[]

  @@map("votacao")
}

model Vote {
  id                Int             @id @default(autoincrement()) @map("idVoto")
  parliamentarianId Int             @map("idParlamentar")
  votingId          Int             @map("idVotacao")
  choice            VoteChoice?     @map("votoRegistrado")

  parliamentarian   Parliamentarian @relation(fields: [parliamentarianId], references: [id])
  voting            Voting          @relation(fields: [votingId], references: [id])

  @@map("voto")
}

model PropositionAuthor {
  parliamentarianId Int @map("idParlamentar")
  propositionId     Int @map("idProposicao")

  parliamentarian   Parliamentarian @relation(fields: [parliamentarianId], references: [id])
  proposition       Proposition     @relation(fields: [propositionId], references: [id])

  @@id([parliamentarianId, propositionId])
  @@map("autoriaProposicao")
}

model SocialNetwork {
  id                Int      @id @default(autoincrement()) @map("idRedeSocial")
  parliamentarianId Int      @map("idParlamentar")
  platform          String?  @db.VarChar(50) @map("plataforma")
  url               String?  @db.VarChar(500)

  parliamentarian   Parliamentarian @relation(fields: [parliamentarianId], references: [id], onDelete: Cascade)

  @@map("redeSocial")
}

model Expense {
  id                Int       @id @default(autoincrement()) @map("idDespesa")
  parliamentarianId Int       @map("idParlamentar")
  expenseDate       DateTime? @db.Date @map("dataDespesa")
  amount            Decimal?  @db.Decimal(10, 2) @map("valor")
  supplierName      String?   @db.VarChar(255) @map("fornecedorNome")
  supplierDocument  String?   @db.VarChar(20) @map("fornecedorCnpjCpf")
  invoiceUrl        String?   @db.VarChar(500) @map("notaFiscalUrl")
  category          String?   @db.VarChar(100) @map("categoria")

  parliamentarian   Parliamentarian @relation(fields: [parliamentarianId], references: [id], onDelete: Cascade)

  @@map("despesa")
}

model Amendment {
  id                  Int       @id @default(autoincrement()) @map("idEmenda")
  code                String    @unique @db.VarChar(100) @map("codigoEmenda")
  year                Int?      @map("ano")
  amendmentType       String?   @db.VarChar(100) @map("tipoEmenda")
  author              String?   @db.VarChar(255) @map("autor")
  authorName          String?   @db.VarChar(255) @map("nomeAutor")
  amendmentNumber     String?   @db.VarChar(100) @map("numeroEmenda")
  spendingLocation    String?   @db.VarChar(255) @map("localidadeDoGasto")
  functionName        String?   @db.VarChar(255) @map("funcao")
  subfunctionName     String?   @db.VarChar(255) @map("subfuncao")
  committedAmount     Decimal?  @db.Decimal(15, 2) @map("valorEmpenhado")
  liquidatedAmount    Decimal?  @db.Decimal(15, 2) @map("valorLiquidado")
  paidAmount          Decimal?  @db.Decimal(15, 2) @map("valorPago")
  remainderRegistered Decimal?  @db.Decimal(15, 2) @map("valorRestoInscrito")
  remainderCanceled   Decimal?  @db.Decimal(15, 2) @map("valorRestoCancelado")
  remainderPaid       Decimal?  @db.Decimal(15, 2) @map("valorRestoPago")

  documents            AmendmentDocument[]
  parliamentarianLinks AmendmentParliamentarian[]

  @@map("emenda")
}

model AmendmentDocument {
  id                Int       @id @default(autoincrement()) @map("idEmendaDocumento")
  amendmentId       Int       @map("idEmenda")
  apiId             Int?      @map("idApi")
  amendmentCode     String    @db.VarChar(100) @map("codigoEmenda")
  date              DateTime? @db.Date @map("data")
  phase             String?   @db.VarChar(100) @map("fase")
  documentCode      String?   @db.VarChar(100) @map("codigoDocumento")
  shortDocumentCode String?   @db.VarChar(100) @map("codigoDocumentoResumido")
  speciesType       String?   @db.VarChar(255) @map("especieTipo")
  amendmentType     String?   @db.VarChar(100) @map("tipoEmenda")

  amendment         Amendment @relation(fields: [amendmentId], references: [id], onDelete: Cascade)

  @@map("emendaDocumento")
}

model AmendmentParliamentarian {
  id                   Int             @id @default(autoincrement()) @map("idEmendaParlamentar")
  amendmentId          Int             @map("idEmenda")
  amendmentCode        String          @db.VarChar(100) @map("codigoEmenda")
  parliamentarianId    Int             @map("idParlamentar")
  authorNamePortal     String?         @db.VarChar(255) @map("nomeAutorPortal")
  normalizedAuthorName String?         @db.VarChar(255) @map("nomeAutorNormalizado")
  linkMethod           String?         @db.VarChar(100) @map("metodoVinculo")
  confidence           Decimal?        @db.Decimal(5, 2) @map("confiancaVinculo")

  amendment            Amendment       @relation(fields: [amendmentId], references: [id], onDelete: Cascade)
  parliamentarian      Parliamentarian @relation(fields: [parliamentarianId], references: [id], onDelete: Cascade)

  @@unique([amendmentId, parliamentarianId])
  @@map("emendaParlamentar")
}
